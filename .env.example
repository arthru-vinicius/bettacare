# Configuração de runtime do BettaCare.
#
# No homelab este arquivo é gerado pelo vault do Ansible em
# /opt/compose/bettacare/.env com permissão restrita, e montado no container.
# Nenhum destes valores entra na imagem — o mesmo artefato roda em qualquer host.

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# SEGREDO. O cluster Postgres 17 é compartilhado; a role é dona apenas do
# próprio database e não tem superusuário.
DATABASE_URL=postgresql://bettacare_user:TROQUE_AQUI@postgres:5432/bettacare

# SEGREDO. Valor esperado no header X-Api-Token do ESP32. Precisa ser
# **idêntico** ao SERVER_API_TOKEN do firmware (firmware/bettacare/config.h),
# senão o dispositivo leva 401 a cada 3 segundos. Mínimo de 16 caracteres.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEVICE_INGEST_TOKEN=TROQUE_AQUI

# ── Rede ─────────────────────────────────────────────────────────────────────

# Interface web. NÃO publicar porta no host: o cloudflared alcança o container
# pelo nome dele na rede `backend`.
PORT_UI=3000

# Ingestão do ESP32. Publicada COM bind explícito de endereço:
#   ports: ["<IP_DO_SERVIDOR>:8080:8080"]
# Sem o prefixo, o Docker escreve direto na chain DOCKER do iptables, o UFW não
# opina, e a porta fica exposta em todas as interfaces — inclusive na VPN.
PORT_INGEST=8080

# ── Operação ─────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# Só apresentação. O banco é sempre UTC.
TZ_DISPLAY=America/Recife

# Três usuários e um dispositivo. Um pool grande só tira RAM do cache do Postgres.
PG_POOL_MAX=4

# Teto de tamanho do database. Ao ser excedido, o job diário derruba as
# partições mensais mais antigas de `telemetry` e `events`. Padrão: 1 GiB.
DB_SIZE_LIMIT_BYTES=1073741824

# Silêncio a partir do qual o dispositivo é dado como offline.
DEVICE_OFFLINE_AFTER_S=60

# Prazo para o dispositivo confirmar um comando já entregue.
COMMAND_TTL_S=90

# Definido no Dockerfile; só sobrescreva se mudar o layout da imagem.
# WEB_ROOT=/app/web

# ── Opcional ─────────────────────────────────────────────────────────────────

# Defesa em profundidade. O Cloudflare Access já barra quem não deve entrar;
# esta lista só existe caso a policy seja afrouxada por engano. Vazia, a
# aplicação confia inteiramente no Access.
ALLOWED_USER_EMAILS=
