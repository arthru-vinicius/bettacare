{
  "name": "@bettacare/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono: serve o export estático do Next, a API do navegador e o ingest do ESP32",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.json && node dist/db/migrate-cli.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bettacare/contract": "workspace:*",
    "@hono/node-server": "^1.19.7",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.4",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
